FROM golang:alpine AS builder

RUN apk add --no-cache gcc musl-dev

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -ldflags="-s -w" -o aura-server cmd/server/main.go

FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata curl

COPY --from=builder /app/aura-server /usr/bin/aura-server

EXPOSE 8081

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8081/api/entries?limit=1 || exit 1

CMD ["aura-server"]
FROM node:22-alpine

RUN apk add --no-cache curl

WORKDIR /app

COPY package.json bun.lock* ./
RUN npm install

COPY . .

ENV AURA_API_URL=http://aura-api:8081/api

EXPOSE 44100

HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:44100/ || exit 1

CMD ["npx", "tsx", "server.ts"]